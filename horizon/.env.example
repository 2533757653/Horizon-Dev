# Horizon Trading Platform Environment Variables
# Copy this file to .env and fill in your actual values

# Application Settings
HORIZON_APP_HOST=0.0.0.0
HORIZON_APP_PORT=8000
HORIZON_APP_LOG_LEVEL=INFO

# Database Settings
HORIZON_DATABASE_PATH=./data/horizon.db

# LLM Settings
HORIZON_LLM_API_KEY=your-anthropic-api-key-here
HORIZON_LLM_MODEL=claude-sonnet-4-20250514
HORIZON_LLM_ENABLED=false

# Exchange API Keys - Binance
HORIZON_BINANCE_API_KEY=your-binance-api-key
HORIZON_BINANCE_API_SECRET=your-binance-api-secret

# Exchange API Keys - HTX
HORIZON_HTX_API_KEY=your-htx-api-key
HORIZON_HTX_API_SECRET=your-htx-api-secret

# Exchange API Keys - Hyperliquid
HORIZON_HYPERLIQUID_WALLET_ADDRESS=your-wallet-address
HORIZON_HYPERLIQUID_PRIVATE_KEY=your-private-key

# Exchange API Keys - Bitget
HORIZON_BITGET_API_KEY=your-bitget-api-key
HORIZON_BITGET_API_SECRET=your-bitget-api-secret
HORIZON_BITGET_PASSPHRASE=your-bitget-passphrase